# Set this to a DNS name pointing to the deployment host.
APP_DOMAIN=coding.example.org
# Keep clinical-document analysis disabled until organizational approval.
CLINICAL_DATA_APPROVED=false
# Enable only the separate, non-persistent synthetic classroom demo.
SYNTHETIC_DEMO_ENABLED=true
# Set DATABASE_URL in the hosting dashboard to the managed Postgres pooled URL.
# Do not commit credentials; the app applies Alembic migrations during startup.
DATABASE_URL=
REQUIRE_POSTGRES=false
# Point to a reviewed approval record only after the external release gates pass.
RELEASE_APPROVALS_PATH=release-approvals.example.json
