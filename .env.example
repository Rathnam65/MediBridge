# Local development defaults. Replace these for deployment.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=database/medibridge.db
# Optional hosted database. Keep blank for local SQLite.
DATABASE_URL=
# Keep clinical-document analysis disabled until organizational approval.
CLINICAL_DATA_APPROVED=false
RELEASE_APPROVALS_PATH=release-approvals.example.json
# Optional local-only Ollama models. Leave blank for deterministic/lexical fallback.
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=
OLLAMA_EMBEDDING_MODEL=
LOCAL_MODEL_TIMEOUT=12
VECTOR_INDEX_PATH=data/retrieval/medibridge.sqlite
# Optional Hugging Face disease NER model directory, loaded with local_files_only=true.
CLINICAL_NLP_MODEL=
# For a separate frontend origin, list its exact HTTPS origin here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://127.0.0.1:3000
